# Environment files
.env
.env.production

# Firebase service account (contains private keys - never commit)
**/betterclinic-*-firebase-adminsdk-*.json
**/firebase-service-account*.json

# Google Play service account for eas submit (private key — never commit)
**/play-service-account*.json
mobile-app/betterclinic-f1179-*.json

# EAS local credentials (Android keystore passwords — never commit)
mobile-app/credentials.json
.env.local
.env.*.local
**/.env
**/.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# WhatsApp service cache
whatsapp-service/.wwebjs_cache/

# iOS/Android (mobile)
mobile/ios/
mobile/android/





*.db
*.sqlite3
*.sqlite

# Claude Code local session state
.claude/

# Terraform (state may hold secrets; tfvars holds the DB password)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
crash.log

# graphify knowledge-graph output (local cache, never commit)
graphify-out/
**/graphify-out/

# dental-labs runtime uploads (ephemeral, user data)
dental-labs/backend/uploads/

# Android signing vault: private upload keystore + passwords. NEVER commit.
# Stable home for the release key (android/ gets wiped by prebuild --clean).
mobile-app/signing/
*.keystore
*.jks
